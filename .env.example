# Web of Science Starter API（可选；从 Clarivate Developer Portal 申请）
WOS_API_KEY=

# Unpaywall 要求提供真实联系邮箱，强烈建议填写
UNPAYWALL_EMAIL=

# NCBI 建议提供邮箱；高频使用时可另填 NCBI_API_KEY
NCBI_EMAIL=
NCBI_API_KEY=

# Semantic Scholar API key（可选）
S2_API_KEY=

# 可选代理，多个地址用逗号分隔；若含账号密码，只填写在本机 .env 中
PAPERFLOW_PROXIES=

# CNKI 默认打开可见浏览器；稳定登录后可设 1。设 0 可跳过详情摘要抓取
CNKI_HEADLESS=0
CNKI_FETCH_ABSTRACTS=1
