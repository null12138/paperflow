# Copy to /etc/paperflow-web.env; the installer generates credentials.
PAPERFLOW_DATA_ROOT=/var/lib/paperflow
PAPERFLOW_WEB_USERNAME=paperflow
PAPERFLOW_WEB_PASSWORD=CHANGE_ME
PAPERFLOW_WEB_SECRET=CHANGE_ME
PAPERFLOW_WEB_HOST=127.0.0.1
PAPERFLOW_WEB_PORT=8765
PAPERFLOW_WORKER_LOCK=/run/paperflow/worker.lock
PAPERFLOW_DOWNLOAD_WORKERS=4
PAPERFLOW_DOWNLOAD_BATCH_SIZE=50
PAPERFLOW_LOCAL_DISK_PATH=/
PAPERFLOW_MIN_FREE_GB=3
PAPERFLOW_STORAGE_WAIT_SECONDS=30
WOS_API_KEY=
UNPAYWALL_EMAIL=
NCBI_EMAIL=
NCBI_API_KEY=
S2_API_KEY=
OPENALEX_API_KEY=
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
SPRINGER_NATURE_API_KEY=
PAPERFLOW_PROXIES=
PAPERFLOW_OSS_BUCKET=
PAPERFLOW_OSS_ACCESS_KEY=
PAPERFLOW_OSS_SECRET_KEY=
PAPERFLOW_OSS_ENDPOINT=
PAPERFLOW_OSS_REGION=us-east-1
